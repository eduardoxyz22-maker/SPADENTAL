# ============================================================
#  SPADENTAL · Configuracion de la Graph API de Meta
# ------------------------------------------------------------
#  Copia este archivo como ".env" y rellena tus valores.
#  El archivo ".env" esta en .gitignore y NUNCA debe subirse.
#  Si tu token se expuso alguna vez, REGENERALO en
#  https://developers.facebook.com/  ->  tu app  ->  Tokens.
# ============================================================

# Token de acceso (de Pagina, de larga duracion idealmente).
META_ACCESS_TOKEN=pega_aqui_tu_token

# Datos de la app (necesarios solo para intercambiar/renovar tokens).
META_APP_ID=
META_APP_SECRET=

# ID de la cuenta de Instagram Business/Creator (no el @usuario).
# Lo puedes obtener con:  python -m meta_publisher whoami
IG_USER_ID=

# ID de la Pagina de Facebook donde se publicara.
FB_PAGE_ID=

# ---- Anuncios (Marketing API) ----
# Cuenta publicitaria: es el "act=" de la URL de Ads Manager.
# (No es un secreto; aparece en la URL del Administrador de anuncios.)
META_AD_ACCOUNT_ID=1360245352043819

# Business Manager: es el "business_id=" de esa misma URL.
META_BUSINESS_ID=1057933761477026

# Version de la Graph API (opcional). Por defecto: v21.0
GRAPH_API_VERSION=v21.0
